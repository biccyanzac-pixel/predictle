{
  "name": "predictle-leaderboard-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "wrangler dev --local --port 8798 --var ALLOWED_ORIGINS:http://localhost:8090 --var PUZZLE_BASE:http://localhost:8090/puzzles/",
    "db:init:local": "wrangler d1 execute predictle-leaderboard --local --file=schema.sql",
    "db:init": "wrangler d1 execute predictle-leaderboard --remote --file=schema.sql",
    "test": "node test/e2e.mjs http://127.0.0.1:8798",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
